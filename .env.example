# Скопируй этот файл в .env (без .example) и впиши свои настоящие данные.
# Файл .env никогда никуда не заливай (в .gitignore он уже должен быть исключён).

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Твой Gmail-адрес
EMAIL_HOST_USER=your_email@gmail.com

# НЕ обычный пароль от аккаунта! Нужен App Password (пароль приложения).
# Как получить:
# 1. Включи двухфакторную аутентификацию на аккаунте Google (обязательное условие)
# 2. Зайди на https://myaccount.google.com/apppasswords
# 3. Создай пароль приложения (например, назови его "ElectroShop")
# 4. Google выдаст 16-значный код вида "abcd efgh ijkl mnop" - вставь его сюда без пробелов
EMAIL_HOST_PASSWORD=your_16_char_app_password

# От чьего имени будут приходить письма (обычно совпадает с EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=your_email@gmail.com
